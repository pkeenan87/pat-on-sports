# Copy to `.env.local` (via `vercel env pull .env.local` after linking) and fill
# in any values that aren't injected by Vercel integrations.

# Canonical origin. Used for the sitemap, the RSS feed, Open Graph tags,
# and every absolute URL in the build.
PUBLIC_SITE_URL=http://localhost:4321

# Twitter/X handle used in the `twitter:site` card tag, with the leading @.
PUBLIC_TWITTER_SITE=

# Optional: comments API base URL published in /api/v1/manifest.json for the
# native app. Leave unset until Plan 1 ships first-party comments.
PUBLIC_COMMENTS_API_BASE=

# Optional: emergency banner text for the native app (manifest.message).
PUBLIC_APP_BANNER_MESSAGE=

# --- Server-only (never PUBLIC_). Required for comments in production. ---

# Neon Postgres connection string (injected by the Vercel Neon integration).
DATABASE_URL=

# Admin moderation login at /admin/login.
ADMIN_PASSWORD=

# HMAC secret for the admin session cookie.
SESSION_SECRET=

# Salt for SHA-256 hashes of commenter IPs and emails. Raw values are never stored.
IP_HASH_SALT=

# Authorizes GET /api/cron/prune (Vercel Cron sends Authorization: Bearer …).
CRON_SECRET=

# --- Local only (upload script). Never needed at build time or in CI. ---

# Vercel Blob read/write token for `npm run upload-audio`.
BLOB_READ_WRITE_TOKEN=
