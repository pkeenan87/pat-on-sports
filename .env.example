# Copy to `.env` and adjust. Every variable here is PUBLIC_-prefixed, which
# means Astro inlines it into the built HTML — none of these are secrets, and
# nothing in this project needs one.

# Canonical origin. Used for the sitemap, the RSS feed, Open Graph tags and
# every absolute URL in the build. Leave unset locally; the default in
# astro.config.mjs is the production origin.
PUBLIC_SITE_URL=http://localhost:4321

# CommentBox.io project ID for post comment threads. Without it the comment
# box simply doesn't render, which is fine for local development.
PUBLIC_COMMENTBOX_PROJECT_ID=

# Twitter/X handle used in the `twitter:site` card tag, with the leading @.
PUBLIC_TWITTER_SITE=
