---
import { getCategory, type PostMeta } from "../lib/posts";

type Props = {
  post: PostMeta;
};

const { post } = Astro.props;
const category = getCategory(post.tags);
---

<a href={`/blog/${post.slug}`} class="group">
  <article
    class="rounded-xl border bg-white shadow-sm hover:shadow-lg transition-shadow overflow-hidden h-full flex flex-col"
  >
    <div class="relative aspect-[16/9] bg-slate-200">
      {
        post.heroImage ? (
          <img
            src={post.heroImage}
            alt={post.heroAlt || post.title}
            class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center text-slate-400">
            <span class="text-5xl">🏈</span>
          </div>
        )
      }
      <span
        class={`absolute top-3 left-3 ${category.color} text-white text-xs font-semibold px-3 py-1 rounded-full shadow`}
      >
        {category.label}
      </span>
    </div>

    <div class="p-5 flex-1 flex flex-col">
      <p class="text-sm text-slate-500 mb-2">{post.date}</p>
      <h2
        class="text-lg font-semibold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 mb-2"
      >
        {post.title}
      </h2>
      <p class="text-slate-600 text-sm line-clamp-2 flex-1">
        {post.description}
      </p>
    </div>
  </article>
</a>
