---
import {
  formatDisplayDate,
  formatScoreline,
  getCategory,
  getPostResult,
  type PostMeta,
} from "../lib/posts";

type Props = {
  post: PostMeta;
  featured?: boolean;
  eager?: boolean;
};

const { post, featured = false, eager = false } = Astro.props;
const category = getCategory(post.tags);
const result = getPostResult(post);
const displayDate = formatDisplayDate(post.date);
const loading = eager || featured ? "eager" : "lazy";
const fetchPriority = eager || featured ? "high" : undefined;
---

<a href={`/blog/${post.slug}`} class="group block h-full">
  <article
    class:list={[
      "overflow-hidden h-full bg-white border border-silver/40 transition-colors group-hover:border-navy/30 flex flex-col",
      featured ? "rounded-2xl" : "rounded-xl",
    ]}
  >
    <div class="relative bg-navy-muted overflow-hidden aspect-[16/9]">
      {
        post.heroImage ? (
          <img
            src={post.heroImage}
            alt={post.heroAlt || post.title}
            width="1200"
            height="675"
            loading={loading}
            decoding="async"
            fetchpriority={fetchPriority}
            class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        ) : (
          <div class="absolute inset-0 bg-navy" />
        )
      }
      <span
        class={`absolute top-3 left-3 ${category.color} text-white text-[11px] font-display font-bold tracking-[0.14em] uppercase px-2.5 py-1 rounded-full`}
      >
        {category.label}
      </span>
      {
        post.audio?.trim() ? (
          <span class="absolute top-3 right-3 bg-black/70 text-white text-[11px] font-display font-bold tracking-[0.14em] uppercase px-2.5 py-1 rounded-full">
            Listen
          </span>
        ) : null
      }
    </div>

    <div class:list={["flex-1 flex flex-col", featured ? "p-6 md:p-8 justify-center" : "p-5"]}>
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-navy-muted mb-2">
        {
          result && (
            <span
              class:list={[
                "font-display text-[11px] font-bold tracking-widest",
                result.result === "W" && "text-navy",
                result.result === "L" && "text-red",
                result.result === "T" && "text-navy-muted",
              ]}
            >
              {formatScoreline(result)}
            </span>
          )
        }
        {result && displayDate && <span aria-hidden="true">·</span>}
        {displayDate && <time datetime={post.date}>{displayDate}</time>}
        {
          post.readingTimeMinutes ? (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.readingTimeMinutes} min read</span>
            </>
          ) : null
        }
      </p>
      <h2
        class:list={[
          "font-display font-bold tracking-wide text-navy group-hover:text-red transition-colors",
          featured ? "text-3xl md:text-4xl mb-3" : "text-xl line-clamp-2 mb-2",
        ]}
      >
        {post.title}
      </h2>
      <p
        class:list={[
          "text-navy-muted",
          featured ? "text-base line-clamp-3" : "text-sm line-clamp-2 flex-1",
        ]}
      >
        {post.description}
      </p>
    </div>
  </article>
</a>
