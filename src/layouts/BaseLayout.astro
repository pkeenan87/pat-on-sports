---
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";
import Footer from "../components/Footer.astro";
import Header from "../components/Header";
import {
  getUniqueCategories,
  sortPostsByDate,
  toPostMeta,
} from "../lib/posts";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description = "Pat on Sports — weekly Patriots and UCLA recaps, NFL analysis, previews, and takes.",
  image = "/images/patriots-og-default.webp",
  imageAlt,
  imageWidth,
  imageHeight,
  canonical,
  type = "website",
  publishedTime,
  tags = [],
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://patonsports.com");
const pageTitle = title ? `${title} | Pat on Sports` : "Pat on Sports";
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const ogTitle = title ?? "Pat on Sports";
const twitterSite = import.meta.env.PUBLIC_TWITTER_SITE;

const posts = sortPostsByDate(
  (await getCollection("blog")).map(toPostMeta)
);
const categories = getUniqueCategories(posts);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Pat on Sports" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Pat on Sports" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
    {
      jsonLdBlocks.map((block) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-white focus:px-3 focus:py-2 focus:text-navy"
    >
      Skip to content
    </a>
    <Header categories={categories} pathname={pathname} client:idle />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
