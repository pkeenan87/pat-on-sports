---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <p class="text-[11px] font-display font-bold tracking-[0.18em] uppercase text-red mb-3">
      404
    </p>
    <h1 class="font-display text-4xl font-bold tracking-wide text-navy">
      That page is out of bounds.
    </h1>
    <p class="mt-3 text-navy-muted">
      The link might be old, or the play never happened. Head home or browse the
      recaps.
    </p>

    <div class="mt-8 flex gap-3">
      <a
        href="/"
        class="rounded-lg bg-navy text-white px-4 py-2 text-sm font-medium hover:bg-navy-muted"
      >
        Go home
      </a>
      <a
        href="/blog"
        class="rounded-lg border border-silver/50 bg-white px-4 py-2 text-sm font-medium text-navy hover:border-navy/30"
      >
        Browse archive
      </a>
    </div>
  </div>
</BaseLayout>
