---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 text-slate-600">Sorry — we couldn’t find that page.</p>

    <div class="mt-8 flex gap-3">
      <a
        href="/"
        class="rounded-lg bg-slate-900 text-white px-4 py-2 text-sm font-medium hover:bg-slate-800"
      >
        Go home
      </a>
      <a
        href="/blog"
        class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-50"
      >
        Browse blog
      </a>
    </div>
  </div>
</BaseLayout>
