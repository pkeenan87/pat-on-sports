---
import { getCollection, render } from "astro:content";
import AudioPlayer from "../../components/AudioPlayer";
import CommentBox from "../../components/CommentBox";
import PostCard from "../../components/PostCard.astro";
import ProsCons from "../../components/ProsCons.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parseProsConsMarkdown } from "../../lib/prosCons";
import {
  categoryUrl,
  formatDisplayDate,
  formatPostDate,
  formatScoreline,
  getAdjacentPosts,
  getCategory,
  getOpponentTags,
  getPostResult,
  getRelatedPosts,
  sortPostsByDate,
  tagToSlug,
  toPostMeta,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = sortPostsByDate((await getCollection("blog")).map(toPostMeta));
const meta = toPostMeta(post);
const category = getCategory(meta.tags);
const result = getPostResult(meta);
const opponents = getOpponentTags(meta.tags);
const { newer, older } = getAdjacentPosts(allPosts, meta.slug);
const related = getRelatedPosts(allPosts, meta, 3);
const { Content } = await render(post);
const publishedTime = post.data.date
  ? new Date(post.data.date).toISOString()
  : undefined;
const displayDate = formatDisplayDate(meta.date);
const siteUrl = Astro.site ?? new URL("https://patonsports.com");
const canonicalPath = `/blog/${meta.slug}`;
const pageUrl = new URL(canonicalPath, siteUrl).href;
const heroImage = meta.heroImage?.trim() || "/images/patriots-og-default.webp";
const commentProjectId = import.meta.env.PUBLIC_COMMENTBOX_PROJECT_ID;
const prosCons =
  category.label === "Pros & Cons" && post.body
    ? parseProsConsMarkdown(post.body)
    : null;
const useProsConsLayout = Boolean(prosCons?.hasPanels);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: meta.title,
  description: meta.description,
  datePublished: publishedTime,
  image: new URL(heroImage, siteUrl).href,
  author: {
    "@type": "Person",
    name: "Pat",
  },
  publisher: {
    "@type": "Organization",
    name: "Pat on Sports",
    url: siteUrl.href,
  },
  mainEntityOfPage: pageUrl,
  keywords: meta.tags.join(", "),
};
---

<BaseLayout
  title={meta.title}
  description={meta.description?.trim() ||
    "Weekly recaps from Pat on Sports."}
  image={heroImage}
  imageAlt={meta.heroAlt || meta.title}
  imageWidth={1200}
  imageHeight={675}
  canonical={canonicalPath}
  type="article"
  publishedTime={publishedTime}
  tags={meta.tags}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
    <header class="mb-4 sm:mb-6">
      <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-navy-muted mb-3">
        <a
          href={categoryUrl(category.label)}
          class={`${category.color} text-white text-[11px] font-display font-bold tracking-[0.14em] uppercase px-2.5 py-1 rounded-full hover:opacity-90`}
        >
          {category.label}
        </a>
        {
          result && (
            <span
              class:list={[
                "font-display text-[11px] font-bold tracking-widest",
                result.result === "W" && "text-navy",
                result.result === "L" && "text-red",
                result.result === "T" && "text-navy-muted",
              ]}
            >
              {formatScoreline(result)}
            </span>
          )
        }
        {
          displayDate && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={formatPostDate(meta.date)}>{displayDate}</time>
            </>
          )
        }
        {
          meta.readingTimeMinutes ? (
            <>
              <span aria-hidden="true">·</span>
              <span>{meta.readingTimeMinutes} min read</span>
            </>
          ) : null
        }
      </p>
      <h1 class="font-display text-3xl sm:text-5xl font-bold tracking-wide text-navy">
        {meta.title}
      </h1>
      <p class="mt-3 text-sm text-navy-muted">
        By Pat
        {
          meta.round || meta.week ? (
            <>
              <span aria-hidden="true"> · </span>
              {meta.round
                ? meta.round
                : meta.week
                  ? `Week ${meta.week}${meta.season ? ` · ${meta.season}` : ""}`
                  : null}
            </>
          ) : null
        }
      </p>
      {
        opponents.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {opponents.map((tag) => (
              <a
                href={`/tag/${tagToSlug(tag)}`}
                class="rounded-full border border-silver/50 bg-white px-3 py-1 text-xs font-semibold text-navy hover:border-navy/30"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }
      {
        meta.audio?.trim() ? (
          <div class="mt-4">
            <AudioPlayer
              client:visible
              src={meta.audio.trim()}
              title={meta.title}
            />
          </div>
        ) : null
      }
      <div class="mt-5">
        <ShareButtons title={meta.title} url={pageUrl} />
      </div>
    </header>

    <div class="mb-5 sm:mb-7 h-px bg-silver/50"></div>

    {
      meta.heroImage ? (
        <figure class="mb-8 animate-fade-in-up">
          <div class="relative w-full aspect-[16/9] overflow-hidden rounded-xl bg-navy-muted ring-1 ring-silver/40">
            <img
              src={meta.heroImage}
              alt={meta.heroAlt || meta.title}
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
          {meta.heroCaption ? (
            <figcaption class="mt-2 text-sm text-navy-muted text-center">
              {meta.heroCaption}
            </figcaption>
          ) : null}
        </figure>
      ) : null
    }

    {
      useProsConsLayout && prosCons ? (
        <div>
          {
            prosCons.intro.length > 0 ? (
              <div class="prose prose-lg max-w-none prose-slate mb-2 prose-ul:list-disc prose-ul:pl-6">
                {prosCons.intro.map((block) =>
                  block.type === "heading" ? (
                    <h2>{block.text}</h2>
                  ) : block.type === "list" ? (
                    <ul>
                      {block.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{block.text}</p>
                  )
                )}
              </div>
            ) : null
          }
          <ProsCons pros={prosCons.pros} cons={prosCons.cons} />
        </div>
      ) : (
        <article class="prose prose-lg max-w-none prose-slate prose-ul:list-disc prose-ol:list-decimal prose-ul:pl-6 prose-ol:pl-6 prose-li:my-1.5">
          <Content />
        </article>
      )
    }

    <div class="mt-10 rounded-xl border border-silver/40 bg-white p-5">
      <p class="text-sm text-navy-muted">
        Written by <span class="font-semibold text-navy">Pat</span> —
        independent Patriots and UCLA commentary. New posts after each game.
      </p>
      <a href="/rss.xml" class="mt-2 inline-block text-sm font-semibold text-navy hover:text-red">
        Subscribe via RSS →
      </a>
    </div>

    <nav
      aria-label="Previous and next posts"
      class="mt-12 grid gap-4 sm:grid-cols-2 border-t border-silver/40 pt-8"
    >
      {
        older ? (
          <a
            href={`/blog/${older.slug}`}
            class="rounded-xl border border-silver/40 bg-white p-4 hover:border-navy/30"
          >
            <p class="text-[11px] font-display font-bold tracking-[0.14em] uppercase text-navy-muted">
              Older
            </p>
            <p class="mt-1 font-display font-semibold text-navy">{older.title}</p>
          </a>
        ) : (
          <div />
        )
      }
      {
        newer ? (
          <a
            href={`/blog/${newer.slug}`}
            class="rounded-xl border border-silver/40 bg-white p-4 hover:border-navy/30 sm:text-right"
          >
            <p class="text-[11px] font-display font-bold tracking-[0.14em] uppercase text-navy-muted">
              Newer
            </p>
            <p class="mt-1 font-display font-semibold text-navy">{newer.title}</p>
          </a>
        ) : (
          <div />
        )
      }
    </nav>

    {
      related.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-bold tracking-wide uppercase text-navy mb-6">
            More to read
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </section>
      )
    }

    {
      commentProjectId ? (
        <section class="mt-12 border-t border-silver/40 pt-8">
          <h2 class="font-display text-2xl font-bold tracking-wide text-navy">
            Comments
          </h2>
          <p class="mt-2 text-sm text-navy-muted">
            Agree with the Cons? Drop a take below.
          </p>
          <CommentBox client:visible boxId={meta.slug} />
        </section>
      ) : (
        <section class="mt-12 border-t border-silver/40 pt-8">
          <h2 class="font-display text-2xl font-bold tracking-wide text-navy">
            Comments
          </h2>
          <p class="mt-3 text-sm text-navy-muted">
            Comments are coming soon. Meanwhile, share the recap with a friend.
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>
