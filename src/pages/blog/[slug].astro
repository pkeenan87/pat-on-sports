---
import { getCollection, render } from "astro:content";
import AudioPlayer from "../../components/AudioPlayer";
import CommentBox from "../../components/CommentBox";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatDisplayDate,
  formatPostDate,
  getAdjacentPosts,
  getCategory,
  getRelatedPosts,
  sortPostsByDate,
  toPostMeta,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = sortPostsByDate((await getCollection("blog")).map(toPostMeta));
const meta = toPostMeta(post);
const category = getCategory(meta.tags);
const { newer, older } = getAdjacentPosts(allPosts, meta.slug);
const related = getRelatedPosts(allPosts, meta, 3);
const { Content } = await render(post);
const publishedTime = post.data.date
  ? new Date(post.data.date).toISOString()
  : undefined;
const displayDate = formatDisplayDate(meta.date);
---

<BaseLayout
  title={meta.title}
  description={meta.description?.trim() ||
    "Weekly Patriots Pros & Cons from Pat on Sports."}
  image={meta.heroImage?.trim() || "/images/og-default.png"}
  imageAlt={meta.heroAlt || meta.title}
  canonical={`/blog/${meta.slug}`}
  type="article"
  publishedTime={publishedTime}
  tags={meta.tags}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
    <header class="mb-4 sm:mb-6">
      <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-navy-muted mb-3">
        <a
          href={`/blog?category=${encodeURIComponent(category.label)}`}
          class={`${category.color} text-white text-[11px] font-display font-bold tracking-[0.14em] uppercase px-2.5 py-1 rounded-full hover:opacity-90`}
        >
          {category.label}
        </a>
        {
          displayDate && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={formatPostDate(meta.date)}>{displayDate}</time>
            </>
          )
        }
      </p>
      <h1 class="font-display text-3xl sm:text-5xl font-bold tracking-wide text-navy">
        {meta.title}
      </h1>
      {
        meta.audio?.trim() ? (
          <div class="mt-4">
            <AudioPlayer
              client:visible
              src={meta.audio.trim()}
              title={meta.title}
            />
          </div>
        ) : null
      }
    </header>

    <div class="mb-5 sm:mb-7 h-px bg-silver/50"></div>

    {
      meta.heroImage ? (
        <figure class="mb-8 animate-fade-in-up">
          <div class="relative w-full aspect-[16/9] overflow-hidden rounded-xl bg-navy-muted ring-1 ring-silver/40">
            <img
              src={meta.heroImage}
              alt={meta.heroAlt || meta.title}
              width="1200"
              height="675"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
          {meta.heroCaption ? (
            <figcaption class="mt-2 text-sm text-navy-muted text-center">
              {meta.heroCaption}
            </figcaption>
          ) : null}
        </figure>
      ) : null
    }

    <article
      class="prose prose-lg max-w-none prose-slate prose-ul:list-disc prose-ol:list-decimal prose-ul:pl-6 prose-ol:pl-6 prose-li:my-1.5"
    >
      <Content />
    </article>

    <nav
      aria-label="Previous and next posts"
      class="mt-12 grid gap-4 sm:grid-cols-2 border-t border-silver/40 pt-8"
    >
      {
        older ? (
          <a
            href={`/blog/${older.slug}`}
            class="rounded-xl border border-silver/40 bg-white p-4 hover:border-navy/30"
          >
            <p class="text-[11px] font-display font-bold tracking-[0.14em] uppercase text-navy-muted">
              Older
            </p>
            <p class="mt-1 font-display font-semibold text-navy">{older.title}</p>
          </a>
        ) : (
          <div />
        )
      }
      {
        newer ? (
          <a
            href={`/blog/${newer.slug}`}
            class="rounded-xl border border-silver/40 bg-white p-4 hover:border-navy/30 sm:text-right"
          >
            <p class="text-[11px] font-display font-bold tracking-[0.14em] uppercase text-navy-muted">
              Newer
            </p>
            <p class="mt-1 font-display font-semibold text-navy">{newer.title}</p>
          </a>
        ) : (
          <div />
        )
      }
    </nav>

    {
      related.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-bold tracking-wide uppercase text-navy mb-6">
            More {category.label}
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-12 border-t border-silver/40 pt-8">
      <h2 class="font-display text-2xl font-bold tracking-wide text-navy">Comments</h2>
      <CommentBox client:only="react" boxId={meta.slug} />
    </section>
  </div>
</BaseLayout>
