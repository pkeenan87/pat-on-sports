---
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  categoryUrl,
  getCategory,
  isPatriotsPost,
  isUclaPost,
  sortPostsByDate,
  toPostMeta,
} from "../lib/posts";

const posts = sortPostsByDate((await getCollection("blog")).map(toPostMeta));
const patriots = posts.filter(isPatriotsPost);
const ucla = posts.filter(isUclaPost);
const featured = patriots[0];
const featuredSupporting = patriots.slice(1, 3);
const from2025 = patriots
  .filter(
    (post) =>
      post.slug !== featured?.slug &&
      !featuredSupporting.some((item) => item.slug === post.slug) &&
      (post.season === 2025 ||
        getCategory(post.tags).label === "Pros & Cons" ||
        getCategory(post.tags).label === "Preview")
  )
  .slice(0, 6);
const audioFeature = posts.find((post) => post.audio?.trim());
---

<BaseLayout
  image="/images/patriots-og-default.webp"
  imageWidth={1200}
  imageHeight={630}
  imageAlt="Pat on Sports"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-12">
    {
      featured && (
        <section class="grid gap-6 lg:grid-cols-3">
          <div class="lg:col-span-2">
            <PostCard post={featured} featured eager />
          </div>
          {
            featuredSupporting.length > 0 && (
              <div class="flex flex-col gap-6">
                {featuredSupporting.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            )
          }
        </section>
      )
    }

    {
      audioFeature && (
        <section class="mt-10 rounded-xl border border-silver/40 bg-white p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center gap-4">
          <div class="flex-1">
            <p class="text-[11px] font-display font-bold tracking-[0.14em] uppercase text-red">
              Listen
            </p>
            <h2 class="mt-1 font-display text-xl font-bold tracking-wide text-navy">
              {audioFeature.title}
            </h2>
            <p class="mt-1 text-sm text-navy-muted line-clamp-2">
              {audioFeature.description}
            </p>
          </div>
          <a
            href={`/blog/${audioFeature.slug}`}
            class="shrink-0 inline-flex items-center justify-center rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white hover:bg-navy-muted"
          >
            Open player →
          </a>
        </section>
      )
    }

    {
      ucla.length > 0 && (
        <section class="mt-12">
          <div class="flex items-baseline justify-between gap-4 mb-6">
            <h2 class="font-display text-2xl font-bold tracking-wide uppercase text-navy">
              UCLA
            </h2>
            <a
              href={categoryUrl("UCLA")}
              class="text-sm font-medium text-navy-muted hover:text-red"
            >
              All UCLA
            </a>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {ucla.slice(0, 3).map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }

    {
      from2025.length > 0 && (
        <section class="mt-12">
          <div class="flex items-baseline justify-between gap-4 mb-6">
            <h2 class="font-display text-2xl font-bold tracking-wide uppercase text-navy">
              From the 2025 run
            </h2>
            <a href="/blog" class="text-sm font-medium text-navy-muted hover:text-red">
              Full archive
            </a>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {from2025.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-14 rounded-xl border border-silver/40 bg-white p-6 sm:p-8">
      <p class="text-[11px] font-display font-bold tracking-[0.14em] uppercase text-red">
        About Pat
      </p>
      <h2 class="mt-2 font-display text-2xl font-bold tracking-wide text-navy">
        Weekly recaps, without the noise.
      </h2>
      <p class="mt-3 max-w-2xl text-navy-muted font-serif">
        A one-person column on the Patriots and UCLA — what worked, what didn’t,
        and what it means next week.
      </p>
      <a
        href="/about"
        class="mt-4 inline-block font-display font-bold tracking-wide uppercase text-navy hover:text-red"
      >
        More about the column →
      </a>
    </section>
  </div>
</BaseLayout>
