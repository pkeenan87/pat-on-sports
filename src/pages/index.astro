---
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortPostsByDate, toPostMeta } from "../lib/posts";

const posts = sortPostsByDate((await getCollection("blog")).map(toPostMeta));
const [featured, second, third, ...rest] = posts;
const supporting = [second, third].filter(Boolean);
---

<BaseLayout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-12">
    {
      featured && (
        <section class="grid gap-6 lg:grid-cols-3">
          <div class="lg:col-span-2">
            <PostCard post={featured} featured />
          </div>
          {
            supporting.length > 0 && (
              <div class="flex flex-col gap-6">
                {supporting.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            )
          }
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section class="mt-12">
          <div class="flex items-baseline justify-between gap-4 mb-6">
            <h2 class="font-display text-2xl font-bold tracking-wide uppercase text-navy">
              Season recaps
            </h2>
            <a href="/blog" class="text-sm font-medium text-navy-muted hover:text-red">
              Full archive
            </a>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
